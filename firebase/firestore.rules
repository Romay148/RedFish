rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function friendshipId(uidA, uidB) {
      return uidA < uidB ? uidA + "_" + uidB : uidB + "_" + uidA;
    }

    function friendshipAccepted(uidA, uidB) {
      return exists(/databases/$(database)/documents/friendships/$(friendshipId(uidA, uidB))) &&
             get(/databases/$(database)/documents/friendships/$(friendshipId(uidA, uidB))).data.status == "accepted";
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    match /posts/{postId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isSignedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         friendshipAccepted(resource.data.ownerUid, request.auth.uid));
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
