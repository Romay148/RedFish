rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function friendshipId(uidA, uidB) {
      return uidA < uidB ? uidA + "_" + uidB : uidB + "_" + uidA;
    }

    function friendshipAccepted(uidA, uidB) {
      return firestore.exists(/databases/(default)/documents/friendships/$(friendshipId(uidA, uidB))) &&
             firestore.get(/databases/(default)/documents/friendships/$(friendshipId(uidA, uidB))).data.status == "accepted";
    }

    match /users/{ownerUid}/rolls/{monthKey}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == ownerUid;
      allow read: if isSignedIn() &&
        (request.auth.uid == ownerUid || friendshipAccepted(request.auth.uid, ownerUid));
    }
  }
}
